<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser host for the existing C# core: HeroCat.Web.Engine exposes the bridge in web/wasm/BRIDGE.md via [JSExport].
       Build with web/wasm/build.sh (it also produces build/content-pack.json, embedded below as a fallback). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HeroCat.Web</RootNamespace>
    <AssemblyName>HeroCat.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WasmDebugLevel>0</WasmDebugLevel>
    <WasmNativeStrip>true</WasmNativeStrip>
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorEnableCompression>false</BlazorEnableCompression>
    <ContentPackPath>$(MSBuildThisFileDirectory)../../build/content-pack.json</ContentPackPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HeroCat.Sim/HeroCat.Sim.csproj" />
    <ProjectReference Include="../HeroCat.Runtime/HeroCat.Runtime.csproj" />
  </ItemGroup>

  <!-- Newtonsoft.Json (save serializer) reflects over GameState; keep these assemblies whole instead of trimming members. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="HeroCat.Sim" />
    <TrimmerRootAssembly Include="HeroCat.Runtime" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(ContentPackPath)')">
    <EmbeddedResource Include="$(ContentPackPath)" LogicalName="content-pack.json" />
  </ItemGroup>
</Project>
