{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HeroCat": {
    "Version": "dev",
    "Env": "dev",
    "Limits": {
      "IDEMPOTENCY_TTL_H": 24,
      "ACCESS_TOKEN_TTL_S": 3600,
      "REFRESH_TOKEN_TTL_DAYS": 60,
      "REFRESH_REUSE_GRACE_S": 30,
      "SUMMON_LOCK_TTL_S": 10,
      "DUNGEON_SEEDS_PER_DAY": 10,
      "DUNGEON_SEED_TTL_S": 600,
      "REFUND_ABUSE_COUNT": { "SoftFlag": 3, "BanReview": 5, "WindowDays": 90 },
      "MAIL_GRANT_APPROVAL_DIAMONDS": 1000,
      "STAGE_BOUND_MULT": { "Suspicious": 1.5, "Certain": 3 },
      "DPS_BOUND_MARGIN": 0.5,
      "GOLD_BOUND_MULT": { "Suspicious": 2, "Certain": 10 },
      "RESIM_SAMPLE_PCT": 1,
      "BAN_REVIEW_SLA_H": 72,
      "CLOCK_MAX_SKEW_ACCEPT_S": 120,
      "SAVE_BLOB_MAX_BYTES": 262144,
      "SAVE_HISTORY_KEEP": 10,
      "AGE_OF_DIGITAL_CONSENT_DEFAULT": 13,
      "CONFIG_REFRESH_S": 30,
      "ANALYTICS_BATCH_MAX": 100,
      "ANALYTICS_EVENT_MAX_AGE_DAYS": 30,
      "ANALYTICS_PROPS_MAX_BYTES": 4096,
      "PARTITION_AHEAD_MONTHS": 3,
      "PARTITION_AHEAD_DAYS": 14
    },
    "Database": {
      "ConnectionString": "",
      "MigrationsPath": "db/migrations",
      "MigrateOnStartup": false
    },
    "Network": {
      "TrustedProxies": []
    },
    "Keys": {
      "DataKeyKmsKeyId": ""
    },
    "Secrets": {
      "Provider": "none",
      "Region": "us-east-1",
      "ServiceUrl": "",
      "SigningKeysSecretId": "",
      "RecoveryKeySecretId": "",
      "DataKeySecretId": "",
      "RefreshSeconds": 300
    },
    "Redis": {
      "Configuration": ""
    },
    "Analytics": {
      "PlayerIdSalt": ""
    },
    "Blobs": {
      "Provider": "s3",
      "ServiceUrl": "",
      "Region": "us-east-1",
      "ForcePathStyle": false,
      "SavesBucket": "",
      "ReceiptsBucket": ""
    }
  }
}
