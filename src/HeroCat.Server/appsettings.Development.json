{
  "HeroCat": {
    "Keys": {
      "AllowEphemeral": true
    },
    "Analytics": {
      "Env": "local",
      "PlayerIdSalt": "herocat-local"
    },
    "Blobs": {
      "Provider": "memory",
      "SavesBucket": "herocat-saves-local",
      "ReceiptsBucket": "herocat-receipts-local"
    },
    "Telemetry": {
      "MetricsPort": 0
    }
  }
}
