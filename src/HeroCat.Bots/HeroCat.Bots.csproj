<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HeroCat.Bots</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- 01 section 1.2: the harness references Sim and Runtime (ContentLoader, ProfileFactory, FakeClock, save serializer). -->
    <ProjectReference Include="../HeroCat.Sim/HeroCat.Sim.csproj" />
    <ProjectReference Include="../HeroCat.Runtime/HeroCat.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Acceptance/acceptance-targets.json" LogicalName="acceptance-targets.json" />
  </ItemGroup>
</Project>
