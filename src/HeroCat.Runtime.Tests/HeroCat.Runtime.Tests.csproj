<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HeroCat.Runtime/HeroCat.Runtime.csproj" />
    <ProjectReference Include="../HeroCat.Sim/HeroCat.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Unity client's engine-free Core (its asmdef has noEngineReferences) is compiled in here, so dotnet build
         catches client code that drifts from the sim, and SafeAreaMathTests can run without Unity. -->
    <Compile Include="../../unity/HeroCatClient/Assets/HeroCat.Client/Core/**/*.cs" LinkBase="Client" />
  </ItemGroup>
</Project>
